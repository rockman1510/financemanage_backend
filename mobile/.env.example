# Backend base URL. Android emulator: http://10.0.2.2:8080, iOS simulator: http://localhost:8080,
# physical device: http://<your-LAN-IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
# Feature flags (customize per build)
EXPO_PUBLIC_FEATURE_LOAN_PREPAYMENT=true
EXPO_PUBLIC_FEATURE_LOAN_RATE_CHANGE=true
