# Production settings for docker-compose.prod.yml. Copy to .env (never commit it) and fill in every "change-me".
# Generate secrets with: openssl rand -base64 48

# --- Domain and HTTPS (Caddy gets the Let's Encrypt certificate itself; the DNS A record must point here) ---
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# --- Secrets ---
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# at least 32 characters; changing it signs everyone out
JWT_SECRET=change-me
# at least 32 characters; encrypts the two-factor secrets – keep it forever (also needed to restore a backup)
ENCRYPTION_KEY=change-me

# --- Image: built by the GitHub "release" workflow (docker login ghcr.io first), or build it on the server ---
# BACKEND_IMAGE=ghcr.io/rockman1510/financemanage-backend:latest
# BACKUP_IMAGE=ghcr.io/rockman1510/financemanage-backup:latest
# BACKEND_MEMORY=1g

# --- Email (verification codes, password reset). Without SMTP_HOST emails are only written to the log ---
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Sign-in with Google (comma-separated OAuth client ids of the mobile app; empty = off) ---
GOOGLE_CLIENT_IDS=

# --- Push notifications (Expo); the token is only needed with Expo "enhanced push security" ---
EXPO_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# --- Browser clients (the mobile app needs none); comma-separated origins ---
CORS_ALLOWED_ORIGINS=
# Swagger UI / OpenAPI on the public domain
API_DOCS_ENABLED=false

# --- Backups: every day at BACKUP_TIME, kept BACKUP_LOCAL_RETENTION_DAYS days on the server ---
TZ=Asia/Ho_Chi_Minh
BACKUP_TIME=02:30
BACKUP_LOCAL_RETENTION_DAYS=7
# encrypts the backup files (strongly recommended with S3); without it you cannot restore them – keep it safe
BACKUP_PASSPHRASE=change-me
# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces…); empty = local only
S3_BUCKET=
S3_PREFIX=financemanage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
